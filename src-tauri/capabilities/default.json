{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main",
    "page-*"
  ],
  "permissions": [
    "core:default",
    "core:path:default",
    "dialog:default",
    "opener:default",
    "window-state:default",
    "core:window:allow-set-title",
    "core:window:allow-close",
    "updater:default",
    "process:allow-restart"
  ]
}
