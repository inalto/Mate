{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Mate",
  "version": "0.5.0",
  "identifier": "com.mate.notes",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Mate",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; connect-src 'self' ipc: http://ipc.localhost; worker-src 'self' blob:",
      "devCsp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' http://localhost:5173; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; connect-src 'self' ipc: http://ipc.localhost ws://localhost:5173 http://localhost:5173; worker-src 'self' blob: http://localhost:5173",
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/thumbnails/**", "$APPDATA/assets/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["pdf"],
        "mimeType": "application/pdf",
        "name": "PDF document",
        "description": "PDF document",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": ["goodnotes"],
        "name": "GoodNotes file",
        "description": "GoodNotes file",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": ["note"],
        "name": "Notability file",
        "description": "Notability file",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": ["one", "onepkg"],
        "name": "OneNote file",
        "description": "OneNote file",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": ["freenotes", "freenotesv2", "freebackup"],
        "name": "Freenotes file",
        "description": "Freenotes file",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": ["sdocx"],
        "name": "Samsung Notes file",
        "description": "Samsung Notes file",
        "role": "Viewer",
        "rank": "Alternate"
      }
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://github.com/inalto/Mate/releases/latest/download/latest.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJFQkJFRENFNEU1RjdDRTMKUldUamZGOU96dTI3TGhqZ1ovTE1kamVUR1daaUtGK0MwbnFNNWw0TDdYZHE4MnY2bk81Q1dsalUK"
    }
  }
}
